# Hot-reload overlay for npm-installed dsh. Use with:
#   cd <absolute-path-to-dsh-zotero>  # you run this from the dsh-zotero checkout
#   dsh web --patch ./dev-lib.cordis.yml --port 3307
# Note: `dsh` here is the global npm binary. It works from any cwd.
# For harness source builds you use `pnpm dsh` from ../deepseek-harness instead.
#
# Copy this file to dev-lib.cordis.yml and replace <absolute-path-to-dsh-zotero>
# with the absolute path to this checkout, e.g. /path/to/dsh-zotero.
# The sibling harness checkout lives at ../deepseek-harness (local dev layout,
# hard-coded for this machine).
#
# The production web profile disables the loader HMR plugin, so this
# overlay re-enables it for the dev instance and points its base at this
# checkout. The loader's baseUrl is the profile dir, so you must set base
# explicit. Run npm run build or npm run dev and the plugin hot-swaps
# without you restarting dsh.
# This instance disables the profile-installed dsh-zotero (id zotero),
# so the watched copy takes its place. You still get /zotero status and
# the five tools.
# The name must be an absolute path to the BUILT entry. Plain Node cannot
# load src/index.ts. Adjust the path if your checkout lives elsewhere.
# This overlay row has no browser half. The browser half loads only for
# rows whose name is a bare package name. To develop the card, install
# this checkout into the profile with file: and run npm run dev:client.
- id: zotero
  disabled: true
- id: hmr
  disabled: false
  config:
    base: <absolute-path-to-dsh-zotero>
    root:
      - .
- insert:
    - id: zotero-dev
      name: <absolute-path-to-dsh-zotero>/lib/index.js
      config: {}
