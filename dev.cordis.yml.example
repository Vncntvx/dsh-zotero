# Local development overlay. Use with:
#   pnpm dsh web --patch ./dsh-zotero/dev.cordis.yml
#
# Copy this file to dev.cordis.yml and replace
# <absolute-path-to-dsh-zotero> with this checkout's absolute path.
# The `name` must be an absolute path for local --patch overlays.
- insert:
    - id: zotero
      name: '<absolute-path-to-dsh-zotero>/src/index.ts'
      config: {}
    # The scholarly component ships with the bundle disabled, its switch being
    # the plugin manager's "Included components" row. This overlay mounts it so
    # the external tools, their prompt section, and the settings page can be
    # exercised locally.
    - id: scholarly
      name: '<absolute-path-to-dsh-zotero>/src/scholarly/index.ts'
      config: {}
    # The enrichment component (row id `enrichment`) ships disabled. Mounting
    # it makes user-submitted MinerU parsing, read-only reuse of existing
    # artifacts, and local semantic ranking / model management available.
    # Enabling the component accepts document egress to MinerU; every parse
    # still needs an explicit user submission of one specific Zotero PDF
    # attachment or one public PDF URL, after remote-action and session checks.
    # Keep `disabled: true` for the read-only debug stack; flip it to false to
    # exercise enrichment locally. There is no `dsh-zotero/parsing` alias and
    # no legacy config, cache-format, or interface name.
    - id: enrichment
      name: '<absolute-path-to-dsh-zotero>/src/enrichment/index.ts'
      disabled: true
