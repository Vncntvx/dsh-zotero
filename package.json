{
  "name": "dsh-zotero",
  "version": "0.4.1",
  "description": "Let agents search, read, and cite your local Zotero library: find papers, browse notes and annotations, pull evidence by question, open the source document, generate citations.",
  "keywords": [
    "zotero",
    "dsh",
    "deepseek-harness",
    "plugin",
    "research",
    "literature"
  ],
  "author": "Wenjie Xu <wenjie.xu.cn@outlook.com>",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "dev:client": "node scripts/build-client.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm pack --dry-run --ignore-scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "ZOTERO_INTEGRATION=1 vitest run tests/integration/zotero.integration.spec.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:discovery": "node scripts/discovery-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "network:loopback",
      "filesystem:read",
      "settings:write"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.0-rc.7"
      ]
    },
    "capability": {
      "id": "zotero_search",
      "kind": "tool",
      "invocation": "call the registered zotero_search tool with a query against the local library",
      "expected": "matching items from the connected local Zotero library, or the documented offline error when Zotero is unreachable"
    },
    "evidence": {
      "install": "scripts/discovery-smoke.mjs",
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-registry": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.7",
    "@testing-library/react": "^16.3.0",
    "@types/react": "~18.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-registry": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0",
    "@types/js-yaml": "^4.0.9",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "lightningcss": "^1.33.0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vncntvx/dsh-zotero.git"
  },
  "bugs": {
    "url": "https://github.com/Vncntvx/dsh-zotero/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
