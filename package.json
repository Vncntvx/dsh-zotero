{
  "name": "dsh-zotero",
  "version": "0.13.0-alpha.1",
  "description": "Let agents search, read, and cite your local Zotero library: find papers, browse notes and annotations, pull evidence by question, open the source document, generate citations.",
  "keywords": [
    "zotero",
    "dsh",
    "deepseek-harness",
    "plugin",
    "research",
    "literature"
  ],
  "author": "Wenjie Xu <wenjie.xu.cn@outlook.com>",
  "type": "module",
  "icon": "./docs/images/icon.png",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/images/icon.png",
    "locale",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "dev:client": "node scripts/build-client.mjs --watch",
    "typecheck": "node scripts/harness-state.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node scripts/test-lint.mjs && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:test": "node scripts/test-lint.mjs",
    "harness:check": "node scripts/harness-state.mjs",
    "harness:pin": "node scripts/harness-state.mjs --write",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepare": "node scripts/build-prepare.mjs",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run format:check && node scripts/harness-state.mjs --strict && npm run lint:test && npm run typecheck && npm run test:coverage && npm run build && npm run verify:pack",
    "release:branch": "node scripts/publish-release-branch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "ZOTERO_INTEGRATION=1 vitest run tests/integration/zotero.integration.spec.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:discovery": "node scripts/discovery-smoke.mjs",
    "link:local-harness": "node scripts/link-local-harness.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-jobs": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-timeout": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-values": ">=0.2.1-alpha.1"
  },
